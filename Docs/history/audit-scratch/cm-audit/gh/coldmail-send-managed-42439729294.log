^[[36;1mDC="docker compose -f docker-compose.yml -f tests/harness/compose.test.yml"^[[0m
^[[36;1mregistered=0^[[0m
^[[36;1mfor _ in $(seq 1 30); do^[[0m
^[[36;1m  if $DC logs worker 2>&1 | grep -q "registered over mTLS stream"; then registered=1; break; fi^[[0m
^[[36;1m  if $DC logs worker 2>&1 | grep -q "could not (re)register within the retry budget"; then break; fi^[[0m
^[[36;1m  sleep 1^[[0m
^[[36;1mdone^[[0m
^[[36;1mrc="$(docker inspect -f '{{.RestartCount}}' coldmail-send-managed-worker-1)"^[[0m
^[[36;1mrunning="$(docker inspect -f '{{.State.Running}}' coldmail-send-managed-worker-1)"^[[0m
^[[36;1m# `grep -c` prints 0 but EXITS 1 when nothing matches, and a GitHub step is `bash -e` (no pipefail): without the `|| true`^[[0m
^[[36;1m# this assignment silently killed the step on exactly the HEALTHY path (zero rejections). Invisible locally, where this step^[[0m
^[[36;1m# was re-run as a function without -e. The replica (tools/ci-replica.sh) runs steps with -e and found it.^[[0m
^[[36;1mrejected="$($DC logs worker 2>&1 | grep -c 'register rejected: unauthenticated' || true)"^[[0m
^[[36;1mecho "worker: running=$running RestartCount=$rc registered=$registered register_rejections=$rejected"^[[0m
^[[36;1mif [ "$registered" != "1" ] || [ "$rejected" != "0" ] || [ "$running" != "true" ] || [ "$rc" != "0" ]; then^[[0m
^[[36;1m  echo "FAIL: the worker did not register cleanly on its FIRST attempt."^[[0m
^[[36;1m  echo "register_rejections>0 means it connected before send_managed.boxes carried its"^[[0m
^[[36;1m  echo "token_hash — the seed ran late or not at all — so it was rejected as"^[[0m
^[[36;1m  echo "unauthenticated and exited. It has no restart policy, so it stays dead, and"^[[0m
^[[36;1m  echo "SUITE 3/5 then fail with EMPTY exec output that looks like an mTLS or a volume"^[[0m
^[[36;1m  echo "bug. Check the ordering in scripts/dev.sh's reset case."^[[0m
^[[36;1m  $DC logs worker | tail -20^[[0m
^[[36;1m  exit 1^[[0m
^[[36;1mfi^[[0m
