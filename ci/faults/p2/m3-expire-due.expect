# An entitlement cannot be expired early: the database refuses m3_expire unless enabled_until has passed. The fault drops the due test from the trigger; an early expiry then succeeds.
GATE=m3-expire-due
TARGET=platform
SETUP=
STEP=go test TestM3Schema_ExpireIsRefusedUnlessDue (database integration test, real Postgres)
CMD=H_PG_ADMIN_DSN="$FAULT_ADMIN_DSN" bash tests/harness/run-db-tests.sh '^TestM3Schema_ExpireIsRefusedUnlessDue$'
MESSAGE=--- FAIL: TestM3Schema_ExpireIsRefusedUnlessDue
