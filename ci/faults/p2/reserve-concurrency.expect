# Exit criterion: two concurrent reserves can never overdraw a balance. The fault removes BOTH protections (the store's advisory lock becomes a no-op SELECT and the balances CHECK is dropped from the migration): the forced interleave then overdraws and the test must say OVERDRAW.
GATE=reserve-concurrency
TARGET=platform
SETUP=
STEP=go test TestMoneyConcurrency_ReservesInterleavedAtTheBalanceWrite (database integration test, real Postgres)
CMD=H_PG_ADMIN_DSN="$FAULT_ADMIN_DSN" bash tests/harness/run-db-tests.sh '^TestMoneyConcurrency_ReservesInterleavedAtTheBalanceWrite$'
MESSAGE=--- FAIL: TestMoneyConcurrency_ReservesInterleavedAtTheBalanceWrite
MESSAGE=OVERDRAW: available=-10
