# A reserve needs the job's complete price snapshot at the dearest price. The fault removes the trigger that checks it; a reserve against a partial snapshot is then ALLOWED.
GATE=snapshot-complete
TARGET=platform
SETUP=
STEP=go test TestMoneySchema_ReserveNeedsTheCompleteSnapshot (database integration test, real Postgres)
CMD=H_PG_ADMIN_DSN="$FAULT_ADMIN_DSN" bash tests/harness/run-db-tests.sh '^TestMoneySchema_ReserveNeedsTheCompleteSnapshot$'
MESSAGE=--- FAIL: TestMoneySchema_ReserveNeedsTheCompleteSnapshot
