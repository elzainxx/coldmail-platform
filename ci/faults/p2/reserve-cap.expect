# A charge consumes only the reserve it names: charged + released <= reserved per reserve. The fault weakens that CHECK to a tautology; one job can then spend another job's reservation.
GATE=reserve-cap
TARGET=platform
SETUP=
STEP=go test TestMoneySchema_OneJobCannotSpendAnothersReservation (database integration test, real Postgres)
CMD=H_PG_ADMIN_DSN="$FAULT_ADMIN_DSN" bash tests/harness/run-db-tests.sh '^TestMoneySchema_OneJobCannotSpendAnothersReservation$'
MESSAGE=--- FAIL: TestMoneySchema_OneJobCannotSpendAnothersReservation
