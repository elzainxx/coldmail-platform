# The platform never records a convergence module 3 was not seen to be in: converged_version = want_version needs observed = the wanted state. The fault turns the CHECK into a tautology; a false convergence is then ACCEPTED by the database.
GATE=m3-converged
TARGET=platform
SETUP=
STEP=go test TestM3Schema_SyncConvergenceRule (database integration test, real Postgres)
CMD=H_PG_ADMIN_DSN="$FAULT_ADMIN_DSN" bash tests/harness/run-db-tests.sh '^TestM3Schema_SyncConvergenceRule$'
MESSAGE=--- FAIL: TestM3Schema_SyncConvergenceRule
