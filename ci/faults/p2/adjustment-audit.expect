# Ruling OD-4: an adjustment writes an admin_audit row by trigger. The fault removes the trigger; the adjustment still succeeds but the audit table stays empty.
GATE=adjustment-audit
TARGET=platform
SETUP=
STEP=go test TestLedger_AdjustmentAudit (database integration test, real Postgres)
CMD=H_PG_ADMIN_DSN="$FAULT_ADMIN_DSN" bash tests/harness/run-db-tests.sh '^TestLedger_AdjustmentAudit$'
MESSAGE=--- FAIL: TestLedger_AdjustmentAudit
MESSAGE=the admin_audit rows for the adjustment are [], want exactly [
