# Close-out C2: the suspension read route reports a monotonic `version`, bumped by the suspend and unsuspend writes in the SAME statement that flips the flag. The fault removes the bump from the unsuspend statement: the flag still flips but the counter does not move, so a caller that read the version after reinstating would see a STALE one. The real handlers are driven over real HTTP against real Postgres (migrated with send_byo_0054) and the read after the unsuspend must say version 2. The CMD builds the migrated template database on the stock postgres service first, as tests/harness/run.sh does.
GATE=m3-suspension-read
TARGET=module:coldmail-send-byo
SETUP=
STEP=go test TestUserSuspensionRead_ReportsEveryStateAndVersion (suspend/unsuspend then GET /v1/admin/users/{id}/suspension, real Postgres)
CMD=T=fp_m3_p2c_tpl; TPL="${FAULT_ADMIN_DSN%/*}/$T"; psql "$FAULT_ADMIN_DSN" -v ON_ERROR_STOP=1 -q -c "DROP DATABASE IF EXISTS $T" -c "CREATE DATABASE $T" && psql "$TPL" -v ON_ERROR_STOP=1 -q -c "CREATE TABLE IF NOT EXISTS public.users(id uuid primary key default gen_random_uuid(), email text, is_active boolean default true, created_at timestamptz default now())" -c "CREATE TABLE IF NOT EXISTS public.job_items(id uuid primary key default gen_random_uuid(), campaign_id uuid, user_id uuid, recipient_email text, rendered_subject text, rendered_body text, reply_to text, status text, created_at timestamptz default now())" && (cd tools/send-byo-migrate && go build -o bin/send-byo-migrate .) && MIGRATE_DATABASE_URL="$TPL" SEND_BYO_MODULE_PASSWORD=devmodulepass tools/send-byo-migrate/bin/send-byo-migrate up-and-set-password && cd services/control && TEST_ADMIN_DATABASE_URL="$FAULT_ADMIN_DSN" TEST_TEMPLATE_DB="$T" SEND_BYO_MODULE_PASSWORD=devmodulepass go test -count=1 -v -run '^TestUserSuspensionRead_ReportsEveryStateAndVersion$' ./internal/adminapi/
MESSAGE=--- FAIL: TestUserSuspensionRead_ReportsEveryStateAndVersion
MESSAGE=after unsuspend: version=1, want 2
