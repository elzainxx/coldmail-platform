      "properties": {
        "email": {
          "type": "string"
        },
        "policy": {
          "type": "string"
        }
      },
      "required": [
        "email"
      ],
      "type": "object"
    }
  },
  "vendor_fallback": {
    "opt_out_policy": "cold-email-no-vendor",
    "reachable": false
  },
  "vocabularies": {
    "cancel_outcome": {
      "fields": [
        "job.cancel.cancel_outcome"
      ],
      "source": "module_constant",
      "values": [
        "cancelled",
        "already_cancelled",
        "already_complete"
      ]
    },
    "detail_issue": {
      "fields": [
        "error.details[].issue"
      ],
      "source": "module_constant",
      "values": [
        "required",
        "malformed",
        "out_of_range",
        "not_found",
        "conflict",
        "duplicate"
      ]
    },
    "failure_origin": {
      "fields": [
        "verify.signals.failure_origin",
        "job.results[].signals.failure_origin"
      ],
      "source": "module_constant",
      "values": [
        "own",
        "remote",
        "undetermined"
      ]
    },
    "job_status": {
      "fields": [
        "job.status"
      ],
      "source": "module_constant",
      "values": [
        "submitted",
        "running",
        "complete",
        "complete_with_unknowns"
      ]
    },
    "non_verdict_reason": {
      "fields": [
        "job.results[].reason (only on a row cancelled before its check began)"
      ],
      "source": "module_constant",
      "values": [
        "cancelled_by_caller"
      ]
    },
    "non_verdict_status": {
      "fields": [
        "job.results[].status (only on a row cancelled before its check began)"
      ],
      "source": "module_constant",
      "values": [
        "cancelled"
      ]
    },
    "reason": {
      "fields": [
        "verify.reason",
        "job.results[].reason"
      ],
      "source": "module_constant",
      "values": [
        "accept_all",
        "accepted",
        "blacklisted_domain",
        "blacklisted_mx",
        "catch_all",
        "connection_failed",
        "disposable",
        "dns_error",
        "external_verified",
        "greylisted",
        "historical_bounce",
        "invalid_domain",
        "invalid_syntax",
        "mailbox_full",
        "mailbox_not_found",
        "no_mx",
        "non_public_mx",
        "null_mx",
        "plausible",
        "provider_no_smtp",
        "role_account",
        "smtp_blocked",
        "smtp_error",
        "smtp_timeout",
        "spam_trap",
        "unknown_error",
        "whitelisted"
      ]
    },
    "recommendation": {
      "fields": [
        "verify.recommendation",
        "job.results[].recommendation"
      ],
      "source": "module_constant",
      "values": [
        "send",
        "review",
        "skip"
      ]
    },
    "smtp_skipped_reason": {
      "fields": [
        "verify.signals.smtp_skipped_reason",
        "job.results[].signals.smtp_skipped_reason"
      ],
      "source": "module_constant",
      "values": [
        "audit_red",
        "no_eligible_node",
        "provider_mx_routed",
        "rate_limited",
        "smtp_unwired",
        "warmup_cap"
      ]
    },
    "status": {
      "fields": [
        "verify.status",
        "job.results[].status",
        "job.totals.by_status (the keys)"
      ],
      "source": "module_constant",
      "values": [
        "valid",
        "invalid",
        "risky",
        "unknown"
      ]
    },
    "submit_status": {
      "fields": [
        "bulk.accepted.status"
      ],
      "source": "module_constant",
      "values": [
        "accepted"
      ]
    }
  }
}
