{
  "api_version": "v1",
  "capabilities": {
    "bulk_verify": true,
    "idempotent_bulk_create": true,
    "job_cancel": true,
    "job_totals": true,
    "quote": false,
    "report": false,
    "run": false,
    "sync_verify": true
  },
  "error_codes": [
    {
      "code": "validation_failed",
      "http_status": 400
    },
    {
      "code": "unauthenticated",
      "http_status": 401
    },
    {
      "code": "not_found",
      "http_status": 404
    },
    {
      "code": "method_not_allowed",
      "http_status": 405
    },
    {
      "code": "idempotency_key_reused",
      "http_status": 409
    },
    {
      "code": "payload_too_large",
      "http_status": 413
    },
    {
      "code": "contract_violation",
      "http_status": 500
    },
    {
      "code": "internal_error",
      "http_status": 500
    },
    {
      "code": "paused",
      "http_status": 503
    },
    {
      "code": "unavailable",
      "http_status": 503
    }
  ],
  "idempotency": {
    "header": "Idempotency-Key",
    "key_pattern": "^[A-Za-z0-9._:-]{1,128}$",
    "replay_response_header": "Idempotent-Replayed",
    "reused_with_other_request": "idempotency_key_reused",
    "route": "POST /v1/verify/bulk",
    "scope": "authenticated_caller"
  },
  "module": "verify",
  "routes": [
    {
      "auth": "per_caller_key_or_legacy_token",
      "description": "Verify one address synchronously; the answer is the verdict object.",
      "id": "aaaaaa",
      "method": "POST",
      "path": "/v1/verify",
      "request_schema_ref": "#/schemas/verify_request",
      "response_schema_ref": "#/schemas/verdict"
    },
    {
      "auth": "per_caller_key",
      "description": "Submit a job of addresses (addresses[] or items[] with item_id). Optional Idempotency-Key header: a repeat with the same request returns the original job (header Idempotent-Replayed: true); the same key with another request is a 409 idempotency_key_reused.",
      "id": "aaaaaaaaaaaaaaaaaa",
      "method": "POST",
      "path": "/v1/verify/bulk",
      "request_schema_ref": "#/schemas/bulk_request",
      "response_schema_ref": "#/schemas/bulk_accepted_response"
    },
    {
      "auth": "per_caller_key",
      "description": "A job's status: complete, counts and totals (submitted, settled, pending, duplicates, malformed, by_status), all from one consistent read.",
      "id": "aaaaaaaaaaaaaaaaaa",
      "method": "GET",
      "path": "/v1/jobs/{id}",
      "response_schema_ref": "#/schemas/job_status_response"
    },
    {
      "auth": "per_caller_key",
      "description": "One result per input row that has an outcome, in ordinal order, cursor-paged. A row cancelled before its check began is served with status cancelled and no verdict. Stable once the job is complete.",
      "id": "aaaaaaaaaaaaaaaaaaa",
      "method": "GET",
      "path": "/v1/jobs/{id}/results",
      "response_schema_ref": "#/schemas/job_results_response"
    },
    {
      "auth": "per_caller_key",
      "description": "Cancel a job: every row not yet claimed becomes cancelled (free, no verdict); rows already leased or in flight finish and settle. Idempotent: a repeat, and a cancel of a job that already finished, are 200 no-ops that say so (cancel_outcome). The answer is the job status.",
      "id": "aaaaaaaaaaaaaaaaaa",
      "method": "POST",
      "path": "/v1/jobs/{id}/cancel",
      "response_schema_ref": "#/schemas/job_cancel_response"
    },
    {
      "auth": "per_caller_key",
      "description": "This document.",
      "id": "aaaaaaaa",
      "method": "GET",
      "path": "/v1/describe"
    },
    {
      "auth": "none",
      "description": "Liveness: the process is up.",
      "id": "aaaaaaa",
      "method": "GET",
      "path": "/healthz",
      "response_schema_ref": "#/schemas/healthz_response"
    },
    {
      "auth": "none",
      "description": "Readiness: pepper, database and (when declared) queue. 200 ready, 503 not_ready.",
      "id": "aaaaaa",
      "method": "GET",
      "path": "/readyz",
      "response_schema_ref": "#/schemas/readyz_response"
    }
  ],
  "schemas": {
    "bulk_accepted_response": {
      "properties": {
        "counts": {
          "properties": {
            "duplicate": {
              "type": "integer"
            },
            "enqueued": {
              "type": "integer"
            },
            "malformed": {
              "type": "integer"
            },
            "total": {
              "type": "integer"
            }
          },
          "required": [
            "total",
            "enqueued",
            "duplicate",
            "malformed"
          ],
          "type": "object"
        },
        "job_id": {
          "type": "string"
        },
        "malformed_rows": {
          "items": {
            "properties": {
              "item_id": {
                "type": "string"
              },
              "ordinal": {
                "type": "integer"
              }
            },
            "required": [
              "ordinal"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "malformed_rows_truncated": {
          "type": "boolean"
        },
        "processing_paused": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "vocabulary": "submit_status"
        }
      },
      "required": [
        "job_id",
        "status",
        "counts",
        "malformed_rows",
        "malformed_rows_truncated",
        "processing_paused"
      ],
      "type": "object"
    },
    "bulk_request": {
      "properties": {
        "addresses": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "caller_ref": {
          "type": "string"
        },
        "items": {
          "items": {
            "properties": {
              "address": {
                "type": "string"
              },
              "item_id": {
                "type": "string"
              }
            },
            "required": [
              "item_id",
              "address"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "policy": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "error_response": {
      "properties": {
        "error": {
          "properties": {
            "code": {
              "type": "string"
            },
            "details": {
              "items": {
                "properties": {
                  "field": {
                    "type": "string"
                  },
                  "issue": {
                    "type": "string",
                    "vocabulary": "detail_issue"
                  }
                },
                "required": [
                  "field",
                  "issue"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "message": {
              "type": "string"
            },
            "request_id": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message",
            "request_id"
          ],
          "type": "object"
        }
      },
      "required": [
        "error"
      ],
      "type": "object"
    },
    "healthz_response": {
      "properties": {
        "at": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "at"
      ],
      "type": "object"
    },
    "job_cancel_response": {
      "properties": {
        "caller_ref": {
          "type": "string"
        },
        "cancel_outcome": {
          "type": "string",
          "vocabulary": "cancel_outcome"
        },
        "cancel_requested": {
          "type": "boolean"
        },
        "complete": {
          "type": "boolean"
        },
        "counts": {
          "properties": {
            "cancelled": {
              "type": "integer"
            },
            "pending": {
              "type": "integer"
            },
            "settled": {
              "type": "integer"
            },
            "total": {
              "type": "integer"
            }
          },
          "required": [
            "total",
            "settled",
            "pending",
            "cancelled"
          ],
          "type": "object"
        },
        "job_id": {
          "type": "string"
        },
        "processing_paused": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "vocabulary": "job_status"
        },
        "totals": {
          "properties": {
            "by_status": {
              "properties": {
                "invalid": {
                  "type": "integer"
                },
                "risky": {
                  "type": "integer"
                },
                "unknown": {
                  "type": "integer"
                },
                "valid": {
                  "type": "integer"
                }
              },
              "required": [
                "valid",
                "invalid",
                "risky",
                "unknown"
              ],
              "type": "object"
            },
            "cancelled": {
              "type": "integer"
            },
            "duplicates": {
              "type": "integer"
            },
            "malformed": {
              "type": "integer"
            },
            "pending": {
              "type": "integer"
            },
            "settled": {
              "type": "integer"
            },
            "submitted": {
              "type": "integer"
            }
          },
          "required": [
            "submitted",
            "settled",
            "pending",
            "duplicates",
            "malformed",
            "cancelled",
            "by_status"
          ],
          "type": "object"
        }
      },
      "required": [
        "job_id",
        "status",
        "complete",
        "caller_ref",
        "counts",
        "totals",
        "processing_paused",
        "cancel_requested",
        "cancel_outcome"
      ],
      "type": "object"
    },
    "job_results_response": {
      "properties": {
        "job_id": {
          "type": "string"
        },
        "next_cursor": {
          "type": "string"
        },
        "results": {
          "items": {
            "properties": {
              "api_version": {
                "type": "string"
              },
              "confidence": {
                "type": "integer"
              },
              "domain": {
                "type": "string"
              },
              "duplicate_of": {
                "type": "integer"
              },
              "email": {
                "type": "string"
              },
              "flags": {
                "type": "object"
              },
              "item_id": {
                "type": "string"
              },
              "meta": {
                "type": "object"
              },
              "ordinal": {
                "type": "integer"
              },
              "raw": {
                "type": "null"
              },
              "reason": {
                "or_vocabulary": "non_verdict_reason",
                "type": "string",
                "vocabulary": "reason"
              },
              "recommendation": {
                "type": "string",
                "vocabulary": "recommendation"
              },
              "signals": {
                "type": "object"
              },
              "status": {
                "or_vocabulary": "non_verdict_status",
                "type": "string",
                "vocabulary": "status"
              }
            },
            "required": [
              "api_version",
              "status",
              "reason",
              "confidence",
              "recommendation",
              "email",
              "domain",
              "flags",
              "signals",
              "meta",
              "raw",
              "ordinal"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "job_id",
        "results",
        "next_cursor"
      ],
      "type": "object"
    },
    "job_status_response": {
      "properties": {
        "caller_ref": {
          "type": "string"
        },
        "cancel_requested": {
          "type": "boolean"
        },
        "complete": {
          "type": "boolean"
        },
        "counts": {
          "properties": {
            "cancelled": {
              "type": "integer"
            },
            "pending": {
              "type": "integer"
            },
            "settled": {
              "type": "integer"
            },
            "total": {
              "type": "integer"
            }
          },
          "required": [
            "total",
            "settled",
            "pending",
            "cancelled"
          ],
          "type": "object"
        },
        "job_id": {
          "type": "string"
        },
        "processing_paused": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "vocabulary": "job_status"
        },
        "totals": {
          "properties": {
            "by_status": {
              "properties": {
                "invalid": {
                  "type": "integer"
                },
                "risky": {
                  "type": "integer"
                },
                "unknown": {
                  "type": "integer"
                },
                "valid": {
                  "type": "integer"
                }
              },
              "required": [
                "valid",
                "invalid",
                "risky",
