              "type": "integer"
            },
            "pending": {
              "type": "integer"
            },
            "settled": {
              "type": "integer"
            },
            "submitted": {
              "type": "integer"
            }
          },
          "required": [
            "submitted",
            "settled",
            "pending",
            "duplicates",
            "malformed",
            "cancelled",
            "by_status"
          ],
          "type": "object"
        }
      },
      "required": [
        "job_id",
        "status",
        "complete",
        "caller_ref",
        "counts",
        "totals",
        "processing_paused",
        "cancel_requested"
      ],
      "type": "object"
    },
    "readyz_response": {
      "properties": {
        "at": {
          "type": "string"
        },
        "checks": {
          "type": "object"
        },
        "config": {
          "type": "string"
        },
        "pepper": {
