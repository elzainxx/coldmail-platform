        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "type": "string"
        },
        "supabaseKey": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "checks",
        "at",
        "ready",
        "config",
        "pepper",
        "supabaseKey"
      ],
      "type": "object"
    },
    "verdict": {
      "properties": {
        "api_version": {
          "type": "string"
        },
        "confidence": {
          "type": "integer"
        },
        "domain": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "flags": {
