{
  "api_version": "v1",
  "bulk_add": {
    "warning_code": "credentials_in_plaintext_file",
    "warning_text": "The file you are about to upload contains plaintext SMTP passwords. It exists on your own disk (and anywhere it has been emailed or synced to) until you delete it. Delete it after upload. We store your credentials encrypted and never show them again, so this file is not a backup you can rely on — keeping it is pure downside."
  },
  "capabilities": {
    "click_tracking": false,
    "content_variation": true,
    "open_tracking": false,
    "reply_to_per_campaign": true,
    "sequences": false,
    "single_send": true
  },
  "error_codes": [
    {
      "code": "validation_failed",
      "http_status": 400
    },
    {
      "code": "unauthenticated",
      "http_status": 401
    },
    {
      "code": "not_found",
      "http_status": 404
    },
    {
      "code": "method_not_allowed",
      "http_status": 405
    },
    {
      "code": "conflict",
      "http_status": 409
    },
    {
      "code": "unprocessable",
      "http_status": 422
    },
    {
      "code": "rate_limited",
      "http_status": 429
    },
    {
      "code": "internal_error",
      "http_status": 500
    },
    {
      "code": "paused",
      "http_status": 503
    }
  ],
  "extension_routes": [
    {
      "auth": "platform_service_token",
      "description": "Create an account for the caller's tenant. Verify-on-add is mandatory.",
      "id": "aaaaaaaaaaaaaaa",
      "method": "POST",
      "path": "/v1/send-byo/accounts",
      "request_schema_ref": "#/schemas/accounts_create_request",
      "response_schema_ref": "#/schemas/account_object",
      "scope": "user"
    },
    {
      "auth": "platform_service_token",
      "description": "Create N accounts in one request, paced verification.",
      "id": "aaaaaaaaaaaaaaaaa",
      "method": "POST",
      "path": "aaaaaaaaaaaaaaaaaaaaaaaaaa",
      "request_schema_ref": "#/schemas/accounts_bulk_add_request",
      "response_schema_ref": "#/schemas/accounts_bulk_add_response",
      "scope": "user"
    },
    {
      "auth": "platform_service_token",
      "description": "List the calling user's own sender accounts.",
      "id": "aaaaaaaaaaaaa",
      "method": "GET",
      "path": "/v1/send-byo/accounts",
      "response_schema_ref": "#/schemas/accounts_list_response",
      "scope": "user"
    },
    {
      "auth": "platform_service_token",
      "description": "Read one account, scoped to the caller's own tenant.",
      "id": "aaaaaaaaaaaa",
      "method": "GET",
      "path": "/v1/send-byo/accounts/{id}",
      "response_schema_ref": "#/schemas/account_object",
      "scope": "user"
    },
    {
      "auth": "platform_service_token",
      "description": "Update an account; omitted fields are unchanged.",
      "id": "aaaaaaaaaaaaaaa",
      "method": "PATCH",
      "path": "/v1/send-byo/accounts/{id}",
      "request_schema_ref": "#/schemas/accounts_update_request",
      "response_schema_ref": "#/schemas/account_object",
      "scope": "user"
    },
    {
      "auth": "platform_service_token",
      "description": "Soft-delete an account (retained through account_retention_window_sec).",
      "id": "aaaaaaaaaaaaaaa",
      "method": "DELETE",
      "path": "/v1/send-byo/accounts/{id}",
      "scope": "user"
    },
    {
      "auth": "platform_service_token",
      "description": "The account's own audit trail, scoped to the caller's tenant.",
      "id": "aaaaaaaaaaaaaaa",
      "method": "GET",
      "path": "/v1/send-byo/accounts/{id}/events",
      "response_schema_ref": "#/schemas/account_events_response",
      "scope": "user"
    },
    {
      "auth": "platform_service_token",
      "description": "Disable an account (manual, user-reversible).",
      "id": "aaaaaaaaaaaaaaaa",
      "method": "POST",
      "path": "/v1/send-byo/accounts/{id}/disable",
      "response_schema_ref": "#/schemas/account_object",
      "scope": "user"
    },
    {
      "auth": "platform_service_token",
      "description": "Re-enable a disabled account.",
      "id": "aaaaaaaaaaaaaaa",
      "method": "POST",
      "path": "/v1/send-byo/accounts/{id}/enable",
      "response_schema_ref": "#/schemas/account_object",
      "scope": "user"
    },
    {
      "auth": "platform_service_token",
      "description": "Manually pause an account (does not affect the daily-limit/throttle auto-pauses).",
      "id": "aaaaaaaaaaaaaa",
      "method": "POST",
      "path": "/v1/send-byo/accounts/{id}/pause",
      "response_schema_ref": "#/schemas/account_object",
      "scope": "user"
    },
    {
      "auth": "platform_service_token",
      "description": "Clear a MANUAL pause only (refuses to clear a non-manual reason).",
      "id": "aaaaaaaaaaaaaaaa",
      "method": "POST",
      "path": "/v1/send-byo/accounts/{id}/unpause",
      "response_schema_ref": "#/schemas/account_object",
      "scope": "user"
    },
    {
      "auth": "platform_service_token",
      "description": "Self-serve un-quarantine, rate-limited per day.",
      "id": "aaaaaaaaaaaaaaaaaaaaa",
      "method": "POST",
      "path": "/v1/send-byo/accounts/{id}/unquarantine",
      "response_schema_ref": "#/schemas/account_object",
      "scope": "user"
    },
    {
      "auth": "platform_service_token",
      "description": "Connect + STARTTLS + AUTH only; re-runs the From-alignment check.",
      "id": "aaaaaaaaaaaaa",
      "method": "POST",
      "path": "/v1/send-byo/accounts/{id}/test",
      "request_schema_ref": "#/schemas/accounts_test_request",
      "response_schema_ref": "#/schemas/accounts_test_response",
      "scope": "user"
    },
    {
      "auth": "platform_service_token",
      "description": "A real send to the account's own from_address, forcing this specific account.",
      "id": "aaaaaaaaaaaaaaaaaa",
      "method": "POST",
      "path": "/v1/send-byo/accounts/{id}/test-send",
      "response_schema_ref": "#/schemas/test_send_response",
      "scope": "user"
    },
    {
      "auth": "platform_service_token",
      "description": "Read the caller's own routing_strategy.",
      "id": "aaaaaaaaaaaa",
      "method": "GET",
      "path": "/v1/send-byo/settings",
      "response_schema_ref": "#/schemas/settings_object",
      "scope": "user"
    },
    {
      "auth": "platform_service_token",
      "description": "Write the caller's own routing_strategy.",
      "id": "aaaaaaaaaaaa",
      "method": "PUT",
      "path": "/v1/send-byo/settings",
      "request_schema_ref": "#/schemas/settings_object",
      "response_schema_ref": "#/schemas/settings_object",
      "scope": "user"
    },
    {
      "auth": "platform_service_token",
      "description": "Per-user, per-UTC-day usage metrics, derived from jobs/job_events (§6).",
      "id": "aaaaaaaaa",
      "method": "GET",
      "path": "/v1/send-byo/usage",
      "response_schema_ref": "#/schemas/usage_response",
      "scope": "user"
    },
    {
      "auth": "platform_service_token",
      "description": "The caller's own notifications (quarantines, campaign expiries), oldest first.",
      "id": "aaaaaaaaaaaaaaaaaa",
      "method": "GET",
      "path": "aaaaaaaaaaaaaaaaaaaaaaaaaa",
      "response_schema_ref": "#/schemas/notifications_list_response",
      "scope": "user"
    }
  ],
  "module": "send_byo",
  "pricing": {
    "cost_fields_inert": true,
    "currency": "credits",
    "model": "flat_subscription",
    "models": [
      "flat_per_recipient",
      "flat_subscription",
      "free"
    ],
    "tiers": [
      {
        "description": "Base SMTP sending.",
        "id": "aaaaaa",
        "unit_price_credits": 0
      },
      {
        "description": "User-owned SMTP account.",
        "id": "aaaaaaaaa",
        "unit_price_credits": 0
      }
    ],
    "unit_price_credits": 0
  },
  "schemas": {
    "account_events_response": {
      "properties": {
        "results": {
          "type": "array"
        }
      },
      "type": "object"
    },
    "account_object": {
      "properties": {
        "disabled": {
          "type": "boolean"
        },
        "from_address": {
          "type": "string"
        },
        "has_credential": {
          "type": "boolean"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "paused": {
          "type": "boolean"
        },
        "quarantined": {
          "type": "boolean"
        },
        "smtp_host": {
          "type": "string"
        },
        "smtp_username": {
          "type": "string"
        },
        "user_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "type": "object"
    },
    "accounts_bulk_add_request": {
      "properties": {
        "accounts": {
          "items": {
            "properties": {
              "daily_limit": {
                "type": "integer"
              },
              "from_address": {
                "type": "string"
              },
              "from_name": {
                "type": "string"
              },
              "smtp_host": {
                "type": "string"
              },
              "smtp_port": {
                "type": "integer"
              },
              "smtp_secret": {
                "type": "string"
              },
              "smtp_username": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "type": "array"
        },
        "user_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "user_id",
        "accounts"
      ],
      "type": "object"
    },
    "accounts_bulk_add_response": {
      "properties": {
        "request_id": {
          "type": "string"
        },
        "results": {
          "type": "array"
        }
      },
      "type": "object"
    },
    "accounts_create_request": {
      "properties": {
        "daily_limit": {
          "type": "integer"
        },
        "from_address": {
          "type": "string"
        },
        "from_name": {
          "type": "string"
        },
        "smtp_host": {
          "type": "string"
        },
        "smtp_port": {
          "type": "integer"
        },
        "smtp_secret": {
          "type": "string"
        },
        "smtp_username": {
          "type": "string"
        },
        "user_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "user_id",
        "smtp_host",
        "smtp_username",
        "smtp_secret",
        "from_address"
      ],
      "type": "object"
    },
    "accounts_list_response": {
      "properties": {
        "next_cursor": {
          "type": "string"
        },
        "results": {
          "items": {
            "$ref": "#/schemas/account_object"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "accounts_test_request": {
      "properties": {
        "acknowledge_alignment_warning": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "accounts_test_response": {
      "properties": {
        "from_alignment": {
          "type": "object"
        },
        "verification": {
          "type": "object"
        }
      },
      "type": "object"
    },
    "accounts_update_request": {
      "properties": {
        "acknowledge_alignment_warning": {
          "type": "boolean"
        },
        "daily_limit": {
          "type": "integer"
        },
        "from_address": {
          "type": "string"
        },
        "from_name": {
          "type": "string"
        },
        "smtp_host": {
          "type": "string"
        },
        "smtp_port": {
          "type": "integer"
        },
        "smtp_secret": {
          "type": "string"
        },
        "smtp_username": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "notifications_list_response": {
      "properties": {
        "items": {
          "items": {
            "properties": {
              "cleared_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "condition": {
                "type": "string"
              },
              "first_seen_at": {
                "type": "string"
              },
              "id": {
                "format": "uuid",
                "type": "string"
              },
              "last_seen_at": {
                "type": "string"
              },
              "notified_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "payload": {
                "type": "object"
              },
              "severity": {
                "enum": [
                  "critical",
                  "warning",
                  "info"
                ],
                "type": "string"
              },
              "state": {
                "enum": [
                  "pending",
                  "delivered",
                  "suppressed",
                  "cleared"
                ],
                "type": "string"
              },
              "subject_id": {
                "format": "uuid",
                "type": [
                  "string",
                  "null"
                ]
              },
              "subject_type": {
                "enum": [
                  "account",
                  "campaign",
                  "pool",
                  null
                ],
                "type": [
                  "string",
                  "null"
                ]
              },
              "user_id": {
                "format": "uuid",
                "type": "string"
              }
            },
            "type": "object"
          },
          "type": "array"
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "settings_object": {
      "properties": {
        "routing_strategy": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "test_send_response": {
      "properties": {
        "job_id": {
          "type": "string"
        },
        "state": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "usage_response": {
      "properties": {
        "days": {
          "type": "array"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "user_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "vocabularies": {
    "bulk_add_row_status": {
      "fields": [
        "accounts_bulk_add_response.results[].status"
      ],
      "source": "module_constant",
      "values": [
        "created",
        "rejected"
      ]
    },
    "credential_verification_state": {
      "fields": [
        "account_object.verification.state"
      ],
      "source": "db_enum",
      "values": [
        "unverified",
        "verified",
        "failed"
      ]
    },
    "detail_issue": {
      "fields": [
        "error.details[].issue"
      ],
      "source": "module_constant",
      "values": [
        "required",
        "malformed",
        "out_of_range",
        "not_found",
        "conflict"
      ]
    },
    "dmarc_policy": {
      "fields": [
        "account_object.from_alignment.dmarc_policy"
      ],
      "source": "db_enum",
      "values": [
        "none",
        "quarantine",
        "reject"
      ]
    },
    "error_class": {
      "fields": [
        "report.error_class",
        "report.items[].error_class"
      ],
      "source": "db_enum",
      "values": [
        "bounce_permanent",
        "transport_4xx",
        "auth_failure",
        "throttle",
        "timeout",
        "unknown"
      ]
    },
    "event_actor": {
      "fields": [
        "account_events_response.items[].actor"
      ],
      "source": "db_enum",
      "values": [
        "dispatcher",
        "box",
        "reclaim_loop",
        "admin",
        "system",
        "user"
      ]
    },
    "from_verification_state": {
      "fields": [
        "account_object.from_alignment.state"
      ],
      "source": "db_enum",
      "values": [
        "unverified",
        "aligned",
        "unaligned_warned",
        "blocked"
      ]
    },
    "job_state": {
      "fields": [
        "report.state",
        "report.items[].state"
      ],
      "source": "db_enum",
      "values": [
        "queued",
        "assigned",
        "sending",
        "sent",
        "failed",
        "bounced"
      ]
    },
    "notification_condition": {
      "fields": [
        "notifications_list_response.items[].condition"
      ],
      "source": "module_constant",
      "values": [
        "account_quarantined",
        "campaign_expired"
      ]
    },
    "notification_severity": {
      "fields": [
        "notifications_list_response.items[].severity"
      ],
      "source": "db_enum",
      "values": [
        "critical",
        "warning",
        "info"
      ]
    },
    "notification_state": {
      "fields": [
        "notifications_list_response.items[].state"
      ],
      "source": "db_enum",
      "values": [
        "pending",
        "delivered",
        "cleared",
        "suppressed"
      ]
    },
    "notification_subject_type": {
      "fields": [
        "notifications_list_response.items[].subject_type"
      ],
      "source": "module_constant",
      "values": [
        "account",
        "campaign",
        "pool"
      ]
    },
    "pause_reason": {
      "fields": [
        "account_object.status.pause_reason"
      ],
      "source": "db_enum",
      "values": [
        "daily_limit",
        "throttle",
        "manual"
      ]
    },
    "pricing_model": {
      "fields": [
        "describe.pricing.model"
      ],
      "source": "module_constant",
      "values": [
        "flat_per_recipient",
        "flat_subscription",
        "free"
      ]
    },
    "quarantine_reason": {
      "fields": [
        "account_object.status.quarantine_reason"
      ],
      "source": "db_enum",
      "values": [
        "auth_failure",
        "consecutive_failures",
        "failure_rate",
        "manual"
      ]
    },
    "quote_estimate_basis": {
      "fields": [
        "quote.capacity.estimate_basis"
      ],
      "source": "module_constant",
      "values": [
        "current_eligible_capacity"
      ]
    },
    "quote_reason_code": {
      "fields": [
        "quote.reasons[].code"
      ],
      "source": "module_constant",
      "values": [
        "dispatch_disabled",
        "exceeds_queue_cap",
        "no_eligible_accounts",
        "all_accounts_unverified",
        "from_gate_blocked"
      ]
    },
    "quote_warning_code": {
      "fields": [
        "quote.warnings[].code"
      ],
      "source": "module_constant",
      "values": [
        "long_duration"
      ]
    },
    "routing_strategy": {
      "fields": [
        "settings_object.routing_strategy"
      ],
      "source": "db_enum",
      "values": [
        "random",
        "round_robin",
        "one_by_one"
      ]
    }
  }
}
